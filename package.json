    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "pg": "^8.23.1"
  }
}

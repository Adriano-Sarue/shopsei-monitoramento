{
  "name": "shopsei-monitoramento",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de monitoramento de alarmes da Shop Sei",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "simular": "tsx src/simulator/cli.ts",

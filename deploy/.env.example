# Domínio do console (aponte o DNS dele para o IP do servidor antes de subir).
DOMINIO=monitoramento.shopsei.com.br
# Senhas longas e diferentes. A do admin é usada só na primeira subida; troque depois em Usuários.
BANCO_SENHA=troque-por-uma-senha-longa
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-por-outra-senha-longa
# Nome da sua empresa (a primeira, dona do servidor).
EMPRESA_NOME=Shop Sei
# Dono do sistema: cadastra as empresas que compram o uso. Deixe a senha vazia se não for vender.
PLATAFORMA_LOGIN=plataforma
PLATAFORMA_SENHA=
# Porta do feed Sur-Gard (ponte do PC da empresa). Deixe vazio para desligar.
SURGARD_TCP_PORTA=9200
SURGARD_PORTA_PUBLICA=9200
BACKUP_DIAS=30
# Portaria remota: frase longa que cifra a senha dos leitores/interfones no banco. Guarde junto com o backup:
# sem ela o sistema não lê as senhas já cadastradas. Vazio = integração com equipamentos desligada.
CHAVE_EQUIPAMENTOS=
